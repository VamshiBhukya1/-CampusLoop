# Copy to server/.env and replace every local placeholder.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campusloop_app
DB_PASSWORD=change_me_locally
DB_NAME=campusloop
DB_POOL_SIZE=10
DB_SSL=false

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
FILE_STORAGE_DIR=./storage
MAX_PDF_SIZE_MB=15
MAX_STUDY_FILE_SIZE_MB=25
BOOKING_ADVANCE_DAYS=30
MAX_BOOKING_HOURS=4
LOAN_DURATION_DAYS=14
WAITLIST_OFFER_HOURS=24
DUE_REMINDER_HOURS=24
REMINDER_INTERVAL_MINUTES=15

# Required only when running npm run seed. These must be unique local values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_local_password
